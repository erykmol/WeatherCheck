    },
    "invalid_name_error_message" : {
      "comment" : "Explains which characters a city name may contain.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa może zawierać tylko litery, spacje i myślniki, np. „Bielsko-Biała”."
          }
        }
      }
    },
    "invalid_name_error_title" : {
