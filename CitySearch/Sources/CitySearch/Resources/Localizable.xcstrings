{
  "sourceLanguage" : "pl",
  "strings" : {
    "clear_history_dialog_button" : {
      "comment" : "Destructive button in the clear-history dialog.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyść historię"
          }
        }
      }
    },
    "clear_history_dialog_title" : {
      "comment" : "Title of the dialog confirming that recent searches will be cleared.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyścić historię wyszukiwania?"
          }
        }
      }
    },
    "empty_history_message" : {
      "comment" : "Description of the empty state shown before the first search.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz nazwę miasta, aby zobaczyć aktualną pogodę i prognozę na 24 godziny. Ostatnio wyszukiwane miasta pojawią się tutaj."
          }
        }
      }
    },
    "empty_history_title" : {
      "comment" : "Title of the empty state shown before the first search.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukaj miasto"
          }
        }
      }
    },
    "error_details %@" : {
      "comment" : "Error details from the API. The argument is the API's reason, in English.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczegóły: %@"
          }
        }
      }
    },
    "history_clear_button" : {
      "comment" : "Button in the recent searches header that clears them all.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyść"
          }
        }
      }
    },
    "history_remove_button" : {
      "comment" : "Swipe action removing one city from recent searches.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń"
          }
        }
      }
    },
